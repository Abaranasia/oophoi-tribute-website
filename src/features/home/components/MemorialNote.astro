---
import { externalLinks } from "@features/shared/config/site";
---
<section aria-labelledby="memorial-heading" class="mx-auto flex max-w-narrow flex-col items-center gap-6 px-4 py-24 text-center sm:px-6 sm:py-30">
  <svg aria-hidden="true" width="28" height="40" viewBox="0 0 28 40" fill="none" stroke="currentColor" stroke-width="1.2" class="text-accent">
    <path d="M14 2c4 6 6 10 6 14a6 6 0 0 1-12 0c0-4 2-8 6-14z" />
    <path d="M8 26h12v12H8z" />
  </svg>
  <h2 id="memorial-heading" class="text-[44px] leading-tight">In memory</h2>
  <p class="text-[17px] leading-[1.7] text-ink-soft">
    Gianluigi Gasparetti passed away in 2013 after a long illness. This site is an unofficial tribute to his life
    and music.
  </p>
  <div class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-[15px]">
    <a href={externalLinks.obituary}>Read the Hypnos obituary (archived)</a>
    <a href="/memorial/">Memorial</a>
  </div>
</section>
