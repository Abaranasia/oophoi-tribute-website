---
import { Image } from "astro:assets";
import { heroPortrait } from "@features/home/portrait";
---
<section class="page-container grid items-center gap-12 pt-10 pb-20 sm:pt-16 sm:pb-28 md:grid-cols-2 md:gap-18">
  <div class="flex flex-col gap-7">
    <p class="eyebrow text-accent">Gianluigi Gasparetti · 1958 – 2013</p>
    <h1 class="text-[clamp(56px,8vw,112px)] leading-[0.95]">Oöphoi</h1>
    <p class="max-w-[34ch] font-display text-[26px] leading-snug text-ink-soft italic sm:text-[28px]">
      Static, organic, monolithic music: synths, singing bowls, flutes and processed voices, recorded in a
      fifteenth-century stone country house in the hills of central Italy.
    </p>
    <div class="flex flex-wrap items-center gap-4 pt-3">
      <a href="/discography/" class="pill pill-accent">Explore the discography</a>
      <a href="#story" class="inline-flex min-h-12 items-center px-2 text-[15px] text-muted hover:text-ink">Read his story</a>
    </div>
  </div>
  <figure class="mx-auto flex w-full max-w-md flex-col gap-3 md:max-w-none">
    <Image
      src={heroPortrait.src}
      alt={heroPortrait.alt}
      widths={[320, 500]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/5] w-full rounded-[2px] object-cover grayscale-[0.3] contrast-[1.05]"
    />
    <figcaption class="text-[13px] text-muted">Gianluigi Gasparetti with a wooden flute.</figcaption>
  </figure>
</section>
