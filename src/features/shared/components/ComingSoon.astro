---
interface Props {
  title: string;
  /** One sentence about what the page will hold. */
  summary: string;
}

const { title, summary } = Astro.props;
---
<section class="mx-auto flex max-w-narrow flex-col items-center gap-6 px-4 py-24 text-center sm:px-6 sm:py-32">
  <p class="eyebrow text-accent">Coming soon</p>
  <h1 class="text-5xl sm:text-6xl">{title}</h1>
  <p class="text-[17px] leading-relaxed text-ink-soft">{summary}</p>
  <a href="/discography/" class="pill pill-accent">Explore the discography</a>
</section>
