---
import { mainNavigation, site } from "@features/shared/config/site";

const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(href);
---
<header class="page-container flex flex-wrap items-center justify-between gap-x-6 gap-y-4 py-6 sm:py-8">
  <a href="/" class="font-display text-[28px] tracking-[0.08em] text-ink no-underline hover:text-accent-hover">
    {site.name}
  </a>
  <nav aria-label="Main">
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm tracking-[0.14em] uppercase sm:gap-x-7">
      {mainNavigation.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class="inline-flex min-h-11 items-center text-muted no-underline hover:text-ink aria-[current=page]:text-ink"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
